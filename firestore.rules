rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Security Boundaries & Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Security boundary: Server-managed admin role check (hardcoded email bypass removed)
    function isAdmin() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isTeacher() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }

    function teacherOwnsClass(classId) {
      return classId is string &&
        exists(/databases/$(database)/documents/classes/$(classId)) &&
        (
          get(/databases/$(database)/documents/classes/$(classId)).data.teacherId == request.auth.uid ||
          (
            get(/databases/$(database)/documents/classes/$(classId)).data.teacher is string &&
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.displayName is string &&
            get(/databases/$(database)/documents/classes/$(classId)).data.teacher ==
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.displayName
          )
        );
    }

    function teacherCanAccessBooking(bookingData) {
      // `class_month` is the real, live booking type written by the QPay webhook and
      // the free-booking server flow; `class` is the legacy schedule_slot type.
      return isTeacher() &&
        (bookingData.type == 'class' || bookingData.type == 'class_month') &&
        (
          (bookingData.classId is string && teacherOwnsClass(bookingData.classId)) ||
          (bookingData.itemId is string && teacherOwnsClass(bookingData.itemId)) ||
          (
            bookingData.scheduleId is string &&
            exists(/databases/$(database)/documents/schedule/$(bookingData.scheduleId)) &&
            teacherOwnsClass(get(/databases/$(database)/documents/schedule/$(bookingData.scheduleId)).data.classId)
          )
        );
    }

    function bookingScheduleExists(bookingData) {
      return bookingData.scheduleId is string &&
        exists(/databases/$(database)/documents/schedule/$(bookingData.scheduleId));
    }

    function bookingStartTime(bookingData) {
      return bookingData.classStartTime is timestamp
        ? bookingData.classStartTime
        : get(/databases/$(database)/documents/schedule/$(bookingData.scheduleId)).data.startAt;
    }

    function bookingTimeDataAvailable(bookingData) {
      return (bookingData.classStartTime is timestamp) ||
        (
          bookingScheduleExists(bookingData) &&
          get(/databases/$(database)/documents/schedule/$(bookingData.scheduleId)).data.startAt is timestamp
        );
    }

    function isBookingEditableNow(bookingData) {
      return bookingTimeDataAvailable(bookingData) &&
        request.time >= bookingStartTime(bookingData) &&
        request.time <= bookingStartTime(bookingData) + duration.value(24, 'h');
    }

    function teacherCanReadBookingNow(bookingData) {
      return teacherCanAccessBooking(bookingData) &&
        (
          !bookingTimeDataAvailable(bookingData) ||
          request.time <= bookingStartTime(bookingData) + duration.value(24, 'h')
        );
    }

    // ===============================================================
    // Rules
    // ===============================================================

    // Publicly readable collections, Admin writable
    match /blog/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /classes/{classId} {
      allow read: if true;
      // Admins manage all classes; teachers may create/update/delete only classes they own.
      allow create: if isAdmin() || (
        isTeacher() &&
        request.resource.data.teacherId == request.auth.uid
      );
      allow update: if isAdmin() || (
        isTeacher() &&
        resource.data.teacherId == request.auth.uid &&
        request.resource.data.teacherId == request.auth.uid
      );
      allow delete: if isAdmin() || (
        isTeacher() &&
        resource.data.teacherId == request.auth.uid
      );
    }
    
    match /retreats/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /teachers/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /gallery/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /onlineContent/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /mindfulness/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Site-level content (home hero, etc.)
    match /siteContent/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Security boundary: Schedule - seat counts (bookedCount) cannot be modified directly by clients.
    match /schedule/{id} {
      allow read: if true;
      allow create: if isAdmin() || (
        isTeacher() &&
        request.resource.data.classId is string &&
        teacherOwnsClass(request.resource.data.classId)
      );
      allow update: if isAdmin() || (
        isTeacher() &&
        resource.data.classId is string &&
        request.resource.data.classId is string &&
        teacherOwnsClass(resource.data.classId) &&
        teacherOwnsClass(request.resource.data.classId)
      );
      allow delete: if isAdmin() || (
        isTeacher() &&
        resource.data.classId is string &&
        teacherOwnsClass(resource.data.classId)
      );
    }

    // Media library (admin CRUD + picker in admin UI)
    match /media/{id} {
      allow read, write: if isAdmin();
    }

    // Security boundary: User profiles - prevent privilege escalation.
    // Users cannot set 'role', subscription fields, or any privileged profile fields.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      // On creation, normal users can set personal info but CANNOT assign privileged roles or active subscriptions.
      allow create: if isAuthenticated() && request.auth.uid == userId &&
        (!('role' in request.resource.data) || request.resource.data.role in ['client', 'user']) &&
        (!('subscriptionStatus' in request.resource.data) || request.resource.data.subscriptionStatus in ['inactive', null]) &&
        !request.resource.data.keys().hasAny([
          'subscriptionPlan', 'subscriptionStartDate', 'subscriptionEndDate', 'activeUntil', 'passesRemaining'
        ]);

      // On update, normal users can only edit safe personal profile fields.
      // Admin role promotion is strictly restricted to server Admin SDK execution.
      allow update: if (
        isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role',
          'subscriptionStatus',
          'subscriptionPlan',
          'subscriptionStartDate',
          'subscriptionEndDate',
          'activeUntil',
          'passesRemaining'
        ])
      ) || (
        isAdmin() &&
        (request.resource.data.role != 'admin' || resource.data.role == 'admin')
      );

      allow delete: if isAdmin();
    }

    // QPay payment events (Admin SDK writes; clients read own row for UI status; admins read all)
    match /qpayEvents/{invoiceId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create, update, delete: if false;
    }

    // Security boundary: Bookings - confirmed booking creation is handled server-side upon payment fulfillment.
    match /bookings/{id} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isAdmin() ||
        teacherCanReadBookingNow(resource.data)
      );
      // Direct creation of confirmed bookings by clients via Web SDK is forbidden.
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();

      // Security boundary: Per-session attendance. Each doc represents one real calendar
      // occurrence of the class and carries its own classStartTime, so the edit window
      // below is checked against the actual session date, not the whole month enrollment.
      match /sessions/{sessionId} {
        allow read: if isAuthenticated() && (
          get(/databases/$(database)/documents/bookings/$(id)).data.userId == request.auth.uid ||
          isAdmin() ||
          teacherCanAccessBooking(get(/databases/$(database)/documents/bookings/$(id)).data)
        );
        allow create, update: if isAdmin() || (
          teacherCanAccessBooking(get(/databases/$(database)/documents/bookings/$(id)).data) &&
          request.resource.data.classStartTime is timestamp &&
          isBookingEditableNow(request.resource.data) &&
          request.resource.data.attendanceStatus is string &&
          request.resource.data.attendanceStatus in ['attended', 'missed', 'unknown'] &&
          request.resource.data.attendanceMarkedAt is timestamp
        );
        allow delete: if isAdmin();
      }
    }

    // Security boundary: Server-only monthly enrollment counters for class_month capacity
    // enforcement. Never written by clients; Admin SDK writes bypass rules entirely.
    match /classes/{classId}/enrollmentByMonth/{monthKey} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
